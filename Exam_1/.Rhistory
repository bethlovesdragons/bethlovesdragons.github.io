state_max_fatality_rate <- aggregate(fatalrate ~ covdat$Province_State, data = df, FUN = max)
state_max_fatality_rate <- aggregate(fatalrate ~ covdat$Province_State, data = covdat, FUN = max)
colnames(state_max_fatality_rate) <- c("State or Providence", "Case Fatality Ratio")
View(state_max_fatality_rate)
View(state_max_fatality_rate)
state_max_fatality_rate <- aggregate(fatalrate ~ covdat$Province_State, data = covdat, function(x) max(x, na.rm = TRUE))
colnames(state_max_fatality_rate) <- c("State or Providence", "Case Fatality Ratio")
View(state_max_fatality_rate)
state_max_fatality_rate <- aggregate(fatalrate ~ covdat$Province_State, data = covdat, function(x) max(x, na.rm = TRUE))
colnames(state_max_fatality_rate) <- c("Providence_State", "Case_Fatality_Ratio")
state_max_fatality_rate <- state_max_fatality_rate[order(-state_max_fatality_rate$Case_Fatality_Ratio), ]
View(state_max_fatality_rate)
#making covdat a factor by descending fatality rates
state_max_fatality_rate <- state_max_fatality_rate %>%
mutate(covdat = factor(covdat, levels = covdat))
View(state_max_fatality_rate)
#making covdat a factor by descending fatality rates
state_max_fatality_rate <- state_max_fatality_rate %>%
arrange(desc(fatalrate)) %>%             # Make sure descending
mutate(covdat = factor(covdat, levels = covdat))
#making covdat a factor by descending fatality rates
state_max_fatality_rate <- state_max_fatality_rate %>%
arrange(desc(state_max_fatality_rate$Case_Fatality_Ratio)) %>%             # Make sure descending
mutate(state_max_fatality_rate$Providence_State = factor(state_max_fatality_rate$Providence_State, levels = state_max_fatality_rate$Providence_State))
#making covdat a factor by descending fatality rates
state_max_fatality_rate <- state_max_fatality_rate %>%
arrange(desc(state_max_fatality_rate$Case_Fatality_Ratio)) %>%             # Make sure descending
mutate(State = factor(state_max_fatality_rate$Providence_State, levels = state_max_fatality_rate$Providence_State))
#Creating the bar plot I guess
ggplot(state_max_fatality_rate, aes(x = State, y = state_max_fatality_rate$Case_Fatality_Ratio)) +
geom_col(fill = "darkgreen") +
labs(
title = "Peak Fatality Rate by State",
x = "State",
y = "Fatality Rate "
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 90, hjust = 1))
